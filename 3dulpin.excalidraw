      "versionNonce": 212694031,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788193722711,
      "link": null,
      "locked": false,
      "text": "Let citizens and planning departments visualize proposed public\nprojects (a new road, metro line, park) directly against the real 3D\nproperty layer, so people can see exactly how a project would affect\n(or not affect) their property before construction starts.",
      "fontSize": 38.087804109063185,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Let citizens and planning departments visualize proposed public projects (a new road, metro line, park) directly against the real 3D property layer, so people can see exactly how a project would affect (or not affect) their property before construction starts.",
