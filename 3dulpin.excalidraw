      "created": null,
      "baseFontSize": null
    },
    {
      "id": "xQpxmet-p-_Fbadym2jjg",
      "type": "text",
      "x": 4376.1107484087215,
      "y": 941.0145985556858,
      "width": 436.7314897489952,
      "height": 21.90054107023633,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5U",
      "roundness": null,
      "seed": 582485795,
      "version": 448,
      "versionNonce": 2071583233,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788184307384,
      "link": null,
      "locked": false,
      "text": "GPR sends electromagnetic pulses into the ground.",
      "fontSize": 17.52043285618906,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "GPR sends electromagnetic pulses into the ground.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "eTwAEEcpNnIdlAyuGKeYA",
      "type": "text",
      "x": 4376.1107484087215,
      "y": 980.4355724821112,
      "width": 644.646383043127,
      "height": 65.70162321070899,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5V",
      "roundness": null,
      "seed": 168407181,
      "version": 448,
      "versionNonce": 1846604257,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788184307384,
      "link": null,
      "locked": false,
      "text": "When the signal encounters a material/interface with different electrical\nproperties, part of the energy is reflected back. The system records these\nreflections and forms radargrams/B-scans.",
      "fontSize": 17.52043285618906,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "When the signal encounters a material/interface with different electrical properties, part of the energy is reflected back. The system records these reflections and forms radargrams/B-scans.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "EpO_nqnK1xZiN871pMGrP",
      "type": "text",
      "x": 4374.825915274804,
      "y": 1063.10223952683,
      "width": 689.0080249311103,
      "height": 43.80108214047266,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5W",
      "roundness": null,
      "seed": 957426371,
      "version": 468,
      "versionNonce": 1371147713,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788184307384,
      "link": null,
      "locked": false,
      "text": "A pipe can create a characteristic hyperbolic reflection when the antenna passes\nover it.",
      "fontSize": 17.52043285618906,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A pipe can create a characteristic hyperbolic reflection when the antenna passes over it.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
