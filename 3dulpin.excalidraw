      "isDeleted": false,
      "boundElements": [],
      "updated": 1790090972942,
      "link": null,
      "locked": false,
      "text": "using douglas peucker alogorithm \nto convert the jagged blobs or \nuneven segmentation lines to proper\nsimplified polygons (simplify()) ",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "using douglas peucker alogorithm \nto convert the jagged blobs or \nuneven segmentation lines to proper\nsimplified polygons (simplify()) ",
