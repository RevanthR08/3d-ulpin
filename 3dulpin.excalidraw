    {
      "id": "GH-8w0hXLfpHW4NPVm2W2",
      "type": "text",
      "x": 3205.543805701346,
      "y": -352.035586919863,
      "width": 592.613525390625,
      "height": 411.6492497786283,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2D",
      "roundness": null,
      "seed": 1046146363,
      "version": 245,
      "versionNonce": 233051644,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788162613309,
      "link": null,
      "locked": false,
      "text": "Things to identify\n*   Self-intersecting polygon\n*   Zero-area / degenerate polygon\n*   Duplicate/overlapping vertices\n*   Unclosed ring\n*   XY overlap between sibling units\n*   Z-range overlap\n*   Containment violation\n*   Gaps in floor coverage\n*   Cross-parcel encroachment\n*   Height/floor count mismatch",
      "fontSize": 29.93812725662751,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Things to identify\n*   Self-intersecting polygon\n*   Zero-area / degenerate polygon\n*   Duplicate/overlapping vertices\n*   Unclosed ring\n*   XY overlap between sibling units\n*   Z-range overlap\n*   Containment violation\n*   Gaps in floor coverage\n*   Cross-parcel encroachment\n*   Height/floor count mismatch",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "pIrNm36_C2U1kZvvRVNIa",
      "type": "text",
      "x": 3191.926385110535,
      "y": 74.16730944342191,
      "width": 753.0512553156308,
      "height": 375,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2G",
      "roundness": null,
      "seed": 1262914901,
      "version": 500,
      "versionNonce": 575413819,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788113881917,
      "link": null,
      "locked": false,
      "text": "all the algorithms used to validate \n* shamos hoey line segment algo (used to find if a line segment\nintersects)\n* Shoelace Formula (Surveyor's Formula)  computes polygon area from\nvertex coordinates; flag if below threshold\n* Euclidean Distance Thresholding between consecutive vertices\n* Ring Closure Check (first vertex == last vertex) for unclose\npolygon \n* Sweep Line Algorithm\n* 1D Interval Overlap Algorithm\n* Point-in-Polygon Test, specifically the Ray Casting Algorithm\n* Polygon Union + Area Differencing\n* Polygon Intersection (Boolean Clipping) — same Weiler-Atherton or\nVatti clipping algorithm\n* Tolerance-based Statistical Deviation",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "all the algorithms used to validate \n* shamos hoey line segment algo (used to find if a line segment intersects)\n* Shoelace Formula (Surveyor's Formula)  computes polygon area from                           vertex coordinates; flag if below threshold\n* Euclidean Distance Thresholding between consecutive vertices\n* Ring Closure Check (first vertex == last vertex) for unclose polygon \n* Sweep Line Algorithm\n* 1D Interval Overlap Algorithm\n* Point-in-Polygon Test, specifically the Ray Casting Algorithm\n* Polygon Union + Area Differencing\n* Polygon Intersection (Boolean Clipping) — same Weiler-Atherton or Vatti clipping algorithm\n* Tolerance-based Statistical Deviation",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
