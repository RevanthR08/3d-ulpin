      "isDeleted": false,
      "boundElements": [],
      "updated": 1788184307384,
      "link": null,
      "locked": false,
      "text": "For subsurface utilities, we are not trying to detect unknown utilities using AI.\nWe use existing GIS, CAD/BIM and survey data to construct their 3D\nrepresentation. AI is primarily focused on extracting and reconstructing above-\nground property structures, which is the core objective of our project.",
      "fontSize": 17.90217442866649,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "For subsurface utilities, we are not trying to detect unknown utilities using AI. We use existing GIS, CAD/BIM and survey data to construct their 3D representation. AI is primarily focused on extracting and reconstructing above-ground property structures, which is the core objective of our project.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
