    {
      "id": "OVBeYXpNkDTcyme2aweRt",
      "type": "text",
      "x": -9915.51355214485,
      "y": -10414.062866531707,
      "width": 1419.1124332386312,
      "height": 190.43902054531594,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3L",
      "roundness": null,
      "seed": 2119855419,
      "version": 656,
      "versionNonce": 1400337551,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788193722712,
      "link": null,
      "locked": false,
      "text": "A single dashboard where any citizen enters their ULPIN and\ninstantly sees: current record status, all certificates issued, any\npending applications, tax status — think of it as a \"property CIBIL\nscore\" style summary page.",
      "fontSize": 38.087804109063185,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A single dashboard where any citizen enters their ULPIN and instantly sees: current record status, all certificates issued, any pending applications, tax status — think of it as a \"property CIBIL score\" style summary page.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
