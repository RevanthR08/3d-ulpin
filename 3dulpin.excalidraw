      "isDeleted": false,
      "boundElements": [],
      "updated": 1788193722712,
      "link": null,
      "locked": false,
      "text": "2. Real ULPIN ↔ 3D-ULPIN Linking (Backward Compatibility Layer)",
      "fontSize": 32.147588780259824,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2. Real ULPIN ↔ 3D-ULPIN Linking (Backward Compatibility Layer)",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "91AJ2JUIZjMGjVmF_r33l",
      "type": "text",
      "x": -6449.640285862972,
      "y": -12223.292427634493,
      "width": 1229.8373636758454,
      "height": 120.5534579259743,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3n",
      "roundness": null,
      "seed": 99006645,
      "version": 643,
      "versionNonce": 775093839,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788193722712,
      "link": null,
      "locked": false,
      "text": "A lookup table/mapping that connects your new 3D-ULPIN to the\nexisting government-issued base ULPIN (the 2D one that already exists\nfor that land parcel where available).",
      "fontSize": 32.14758878025982,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A lookup table/mapping that connects your new 3D-ULPIN to the existing government-issued base ULPIN (the 2D one that already exists for that land parcel where available).",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "Ejp2D4aklTcmsE-ko7e5-",
      "type": "text",
      "x": -6448.661001008888,
      "y": -12006.548904201962,
      "width": 707.0794677734375,
      "height": 40.18448597532477,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3p",
      "roundness": null,
      "seed": 978835989,
      "version": 635,
      "versionNonce": 117202031,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788193722712,
      "link": null,
      "locked": false,
      "text": "3. Coordinate Accuracy/Precision Tagging",
      "fontSize": 32.14758878025982,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3. Coordinate Accuracy/Precision Tagging",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "izG2_j4WdZ6qGLCuSwiPg",
      "type": "text",
      "x": -6446.753958930091,
      "y": -11956.850132190591,
      "width": 1245.9430427289194,
      "height": 160.73794390129902,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3q",
      "roundness": null,
      "seed": 456801723,
      "version": 646,
      "versionNonce": 1463088783,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788193722712,
      "link": null,
      "locked": false,
      "text": "Every ULPIN record stores the precision class of the coordinates used\nto generate it — e.g., RTK-GPS survey-grade (~cm accuracy) vs.\nsatellite-imagery-derived (~meter accuracy) vs. manually digitized\n(~low accuracy).",
      "fontSize": 32.1475887802598,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Every ULPIN record stores the precision class of the coordinates used to generate it — e.g., RTK-GPS survey-grade (~cm accuracy) vs. satellite-imagery-derived (~meter accuracy) vs. manually digitized (~low accuracy).",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "k2DgQCEQBUDqbZS2gTvG4",
      "type": "text",
      "x": -6442.678574942185,
      "y": -11773.858368882127,
      "width": 813.141357421875,
      "height": 40.18448597532477,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3s",
      "roundness": null,
      "seed": 104910427,
      "version": 636,
      "versionNonce": 1704283311,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788193722712,
      "link": null,
      "locked": false,
      "text": "4. Versioned ULPIN Records (Amendment History)",
      "fontSize": 32.14758878025982,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "4. Versioned ULPIN Records (Amendment History)",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "JrSD1MkOGB-Ij3frkZesk",
      "type": "text",
      "x": -6445.264566226919,
      "y": -11718.124117162273,
      "width": 1250.5081416093,
      "height": 120.5534579259743,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3t",
      "roundness": null,
      "seed": 364779733,
      "version": 685,
      "versionNonce": 231071439,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788193722712,
      "link": null,
      "locked": false,
      "text": "When a parcel's boundary, floor count, or structure changes, the ULPIN\ndoesn't get silently overwritten — it gets a version history (v1, v2,\nv3) with what changed and when, while the ID itself stays constant.",
      "fontSize": 32.14758878025982,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "When a parcel's boundary, floor count, or structure changes, the ULPIN doesn't get silently overwritten — it gets a version history (v1, v2, v3) with what changed and when, while the ID itself stays constant.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "Jcl7M2-RwE49F5Piz2PIH",
      "type": "text",
      "x": -6438.845480826741,
      "y": -11538.15942881565,
      "width": 1144.9034890581256,
      "height": 80.36897195064954,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3v",
      "roundness": null,
      "seed": 1955477045,
      "version": 631,
      "versionNonce": 576662767,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788193722712,
      "link": null,
      "locked": false,
      "text": "5. Standardized Data Exchange Format (GeoJSON + Government\nSchema Compliance)",
      "fontSize": 32.14758878025982,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "5. Standardized Data Exchange Format (GeoJSON + Government Schema Compliance)",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "4ljoZ6ucQeSiiAfcLlAoA",
      "type": "text",
      "x": -6434.3902889227165,
      "y": -11440.904623068707,
      "width": 1261.695537823226,
      "height": 160.73794390129908,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3w",
      "roundness": null,
      "seed": 188691355,
      "version": 653,
      "versionNonce": 250197775,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788193722712,
      "link": null,
      "locked": false,
      "text": "Ensure every ULPIN record you generate strictly follows the same schema\nfields the real DILRMP ULPIN system uses (survey number,\nstate/district/village codes, coordinate reference system, etc.),\noutput as valid GeoJSON.",
      "fontSize": 32.14758878025982,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Ensure every ULPIN record you generate strictly follows the same schema fields the real DILRMP ULPIN system uses (survey number, state/district/village codes, coordinate reference system, etc.), output as valid GeoJSON.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "GiAxocQKFOGyuEMM7_rye",
      "type": "text",
      "x": -6450.884350229806,
      "y": -11273.939996091416,
      "width": 724.7564697265625,
      "height": 40.18448597532477,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3y",
      "roundness": null,
      "seed": 2045511739,
      "version": 655,
      "versionNonce": 970849583,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788193722712,
      "link": null,
      "locked": false,
      "text": "6. Multi-Source Coordinate Reconciliation",
      "fontSize": 32.14758878025982,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "6. Multi-Source Coordinate Reconciliation",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "Y8ojpl4OWhiS0GYkslOaK",
      "type": "text",
      "x": -6453.560052428748,
      "y": -11216.515448881928,
      "width": 1254.815906733056,
      "height": 200.92242987662385,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3z",
      "roundness": null,
      "seed": 1893985525,
      "version": 661,
      "versionNonce": 648314703,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788193722712,
      "link": null,
      "locked": false,
      "text": "When you have multiple data sources for the same parcel (drone survey\n+ satellite + old paper record + GNSS point), the system reconciles\nthem into one authoritative boundary rather than picking one\narbitrarily — e.g., weighted average based on precision tags (from\n#3), with the survey-grade source taking priority.",
      "fontSize": 32.14758878025982,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "When you have multiple data sources for the same parcel (drone survey + satellite + old paper record + GNSS point), the system reconciles them into one authoritative boundary rather than picking one arbitrarily — e.g., weighted average based on precision tags (from #3), with the survey-grade source taking priority.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "trdBH9AedI0TrhLt1UzUf",
      "type": "text",
      "x": -6450.255122975466,
      "y": -10955.562434068514,
      "width": 671.7254638671875,
      "height": 40.18448597532477,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b41",
      "roundness": null,
      "seed": 1881441877,
      "version": 655,
      "versionNonce": 1469431151,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788193722712,
      "link": null,
      "locked": false,
      "text": "7. ULPIN Validity/Certification Status",
      "fontSize": 32.14758878025982,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "7. ULPIN Validity/Certification Status",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "CmwqRTGJ91s0e2h9ZppNR",
      "type": "text",
      "x": -6454.677839191773,
      "y": -10902.420629998856,
      "width": 1156.1873241141266,
      "height": 120.5534579259743,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b42",
      "roundness": null,
      "seed": 1997370747,
      "version": 664,
      "versionNonce": 1878669199,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788193722712,
      "link": null,
      "locked": false,
      "text": "Every ULPIN carries a clear status flag: Draft → Under\nVerification → Certified/Active → Disputed → Superseded — not\njust \"exists or doesn't.\"",
      "fontSize": 32.14758878025982,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Every ULPIN carries a clear status flag: Draft → Under Verification → Certified/Active → Disputed → Superseded — not just \"exists or doesn't.\"",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
