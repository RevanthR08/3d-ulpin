      "type": "text",
      "x": -9927.718830042706,
      "y": -10751.811725900166,
      "width": 1521.9495043331017,
      "height": 190.43902054531594,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3I",
      "roundness": null,
      "seed": 494100789,
      "version": 649,
      "versionNonce": 173866063,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788193722711,
      "link": null,
      "locked": false,
      "text": "When a property has multiple co-owners (common in inherited or apartment\nproperties), provide a structured digital workflow for collecting all\nowners' consent/signatures for a sale, redevelopment, or mortgage —\ntracked against the ULPIN record.",
      "fontSize": 38.087804109063185,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "When a property has multiple co-owners (common in inherited or apartment properties), provide a structured digital workflow for collecting all owners' consent/signatures for a sale, redevelopment, or mortgage — tracked against the ULPIN record.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
