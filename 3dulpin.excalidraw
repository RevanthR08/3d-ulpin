      "boundElements": [],
      "updated": 1788109371191,
      "link": null,
      "locked": false,
      "text": "Cleaned & simplified 2D building\nfootprints (vector) can be later\nexported to \nGeoJSON / Shapefile / KML\nfor GIS, cadastre, or web mapping",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
