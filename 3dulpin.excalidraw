      "locked": false,
      "text": "4. Inheritance/Succession Simplification Assistant",
      "fontSize": 38.087804109063185,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "4. Inheritance/Succession Simplification Assistant",
      "autoResize": true,
