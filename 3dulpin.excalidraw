      "text": "1. Instant Multi-Purpose Certificate Generation",
      "fontSize": 38.087804109063185,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Instant Multi-Purpose Certificate Generation",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "TxAFocIrECQe5MmFzpo1H",
      "type": "text",
      "x": -9951.944533464339,
      "y": -12402.58616391639,
      "width": 1463.3323180165717,
      "height": 238.04877568164494,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b33",
      "roundness": null,
      "seed": 1681376155,
      "version": 646,
      "versionNonce": 483177231,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788193722711,
      "link": null,
      "locked": false,
      "text": "Once a 3D ULPIN exists with verified geometry, auto-generate ready-\nto-use certificates: property extract for bank loans, building height\ncertificate for insurance, area certificate for tax filing — all\npulled from the same verified 3D data instead of citizens visiting\nmultiple offices for each one.",
      "fontSize": 38.087804109063185,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Once a 3D ULPIN exists with verified geometry, auto-generate ready-to-use certificates: property extract for bank loans, building height certificate for insurance, area certificate for tax filing — all pulled from the same verified 3D data instead of citizens visiting multiple offices for each one.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "9Tn0dwQ84lT7aXHsMngHv",
