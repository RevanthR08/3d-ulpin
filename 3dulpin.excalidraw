      "created": null,
      "baseFontSize": null
    },
    {
      "id": "6bMLUFwcR-mjSH-L_nyf6",
      "type": "text",
      "x": -9935.329005935371,
      "y": -11423.322103286908,
      "width": 1475.2539355350227,
      "height": 238.04877568164494,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3C",
      "roundness": null,
      "seed": 970794261,
      "version": 663,
      "versionNonce": 1935989711,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788193722711,
      "link": null,
      "locked": false,
      "text": "When a property owner passes away, guide the legal heir through a\nstructured checklist of exactly which documents are needed to transfer\nthe ULPIN record — since your system knows the parcel's full data\ntrail, it can tell you precisely what's missing vs. what's already\nverified.",
      "fontSize": 38.087804109063185,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "When a property owner passes away, guide the legal heir through a structured checklist of exactly which documents are needed to transfer the ULPIN record — since your system knows the parcel's full data trail, it can tell you precisely what's missing vs. what's already verified.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
