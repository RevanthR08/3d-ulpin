      "updated": 1788193722711,
      "link": null,
      "locked": false,
      "text": "2. Automated Survey Scheduling & Routing Optimization",
      "fontSize": 38.087804109063185,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2. Automated Survey Scheduling & Routing Optimization",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "fBa0-pCuw9NZmYUhByzTR",
      "type": "text",
      "x": -9963.867080916665,
      "y": -12059.580573337047,
      "width": 1406.6957719039553,
      "height": 190.43902054531594,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b36",
      "roundness": null,
      "seed": 1626234101,
      "version": 636,
      "versionNonce": 486046543,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788193722711,
      "link": null,
      "locked": false,
      "text": "Given a list of pending ULPIN generation requests, auto-generate\nthe most efficient survey route/schedule for field surveyors\n(nearest-neighbor route optimization based on GPS clusters),\ninstead of manual, ad-hoc assignment.",
      "fontSize": 38.087804109063185,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Given a list of pending ULPIN generation requests, auto-generate the most efficient survey route/schedule for field surveyors (nearest-neighbor route optimization based on GPS clusters), instead of manual, ad-hoc assignment.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "Njpe3fk8Ku8DFo27ACl2y",
      "type": "text",
      "x": -9957.041321781415,
      "y": -11797.808723451963,
      "width": 963.4240112304688,
      "height": 47.609755136328985,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
