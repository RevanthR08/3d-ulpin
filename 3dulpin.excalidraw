      "isDeleted": false,
      "boundElements": [],
      "updated": 1788193722712,
      "link": null,
      "locked": false,
      "text": "5. Pre-Excavation Utility Clash Check (Before Digging/New Construction)",
      "fontSize": 39.398306615634226,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "5. Pre-Excavation Utility Clash Check (Before Digging/New Construction)",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "8K2-A8sW5iAA4xGD1nQLa",
      "type": "text",
      "x": -8234.25342199711,
      "y": -11128.088457223865,
      "width": 1499.8529418284065,
      "height": 196.99153307817116,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3g",
      "roundness": null,
      "seed": 1357664629,
      "version": 730,
      "versionNonce": 1540087247,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788193722712,
      "link": null,
      "locked": false,
      "text": "Before a new basement, foundation, or underground extension is\napproved, automatically check the proposed excavation depth/footprint\nagainst your subsurface utility network layer (the one you already\nplanned for underground ULPIN coverage).",
      "fontSize": 39.39830661563423,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Before a new basement, foundation, or underground extension is approved, automatically check the proposed excavation depth/footprint against your subsurface utility network layer (the one you already planned for underground ULPIN coverage).",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "nQjShfwQCwZNJm4vCH1ns",
      "type": "text",
      "x": -6453.351761793039,
      "y": -12450.207923259444,
      "width": 1149.004150390625,
      "height": 40.18448597532477,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3j",
      "roundness": null,
      "seed": 1287451125,
