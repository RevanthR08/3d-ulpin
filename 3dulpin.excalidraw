      "updated": 1788193722712,
      "link": null,
      "locked": false,
      "text": "1. Sanctioned Plan vs As-Built Deviation Detector",
      "fontSize": 39.398306615634226,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Sanctioned Plan vs As-Built Deviation Detector",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "vcwQB3H0i02wQjnoJEaJP",
      "type": "text",
      "x": -8205.945995490758,
      "y": -12435.608856396248,
      "width": 1519.0794549283803,
      "height": 196.99153307817113,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3P",
      "roundness": null,
      "seed": 733431483,
      "version": 680,
      "versionNonce": 1577114831,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788193722712,
      "link": null,
      "locked": false,
      "text": "Every building has an originally approved plan (submitted to the\nmunicipal body during construction sanction — floor count, height,\nsetback, FSI/FAR). Your system already extracts the as-built 3D model\nfrom imagery. Automatically diff the two.",
      "fontSize": 39.398306615634226,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Every building has an originally approved plan (submitted to the municipal body during construction sanction — floor count, height, setback, FSI/FAR). Your system already extracts the as-built 3D model from imagery. Automatically diff the two.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "eSnEZKqS4P-l9U4SSzL5_",
      "type": "text",
      "x": -8215.153775509807,
      "y": -12172.63213067486,
      "width": 1408.1920166015625,
      "height": 49.24788326954278,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
