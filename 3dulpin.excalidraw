      "updated": 1788193722711,
      "link": null,
      "locked": false,
      "text": "3. Universal Property ID QR/NFC Tag Generation",
      "fontSize": 38.087804109063185,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3. Universal Property ID QR/NFC Tag Generation",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "2Cp_xklfaBBco_JZxcG0M",
      "type": "text",
      "x": -9917.119911939779,
      "y": -11734.786519495829,
      "width": 1448.3639551328044,
      "height": 190.43902054531594,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b39",
      "roundness": null,
      "seed": 1712326011,
      "version": 666,
      "versionNonce": 645870479,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788193722711,
      "link": null,
      "locked": false,
      "text": "Generate a physical QR code (or NFC tag) tied to each ULPIN that can\nbe printed and affixed at the property entrance — scanning it pulls\nup the public record (not ownership details, just parcel ID + basic\nverified specs).",
      "fontSize": 38.087804109063185,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Generate a physical QR code (or NFC tag) tied to each ULPIN that can be printed and affixed at the property entrance — scanning it pulls up the public record (not ownership details, just parcel ID + basic verified specs).",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "7s-WtAd6QJxRUqPEVtzkK",
