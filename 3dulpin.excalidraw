      "versionNonce": 1565346799,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788193722712,
      "link": null,
      "locked": false,
      "text": "1. ULPIN Uniqueness & Duplicate Prevention (Core Integrity Check)",
      "fontSize": 32.14758878025982,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. ULPIN Uniqueness & Duplicate Prevention (Core Integrity Check)",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "vKz0LbmCWqmCo-1r9Hti0",
      "type": "text",
      "x": -6470.065911628085,
      "y": -12409.459140953975,
      "width": 1252.0512611891481,
      "height": 120.5534579259743,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3k",
      "roundness": null,
      "seed": 523965403,
      "version": 583,
      "versionNonce": 616297999,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788193722712,
      "link": null,
      "locked": false,
      "text": "Before generating any new ULPIN, the system must verify the parcel's\ncoordinates don't already exist under a different ID anywhere in the\ndatabase.",
      "fontSize": 32.14758878025982,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Before generating any new ULPIN, the system must verify the parcel's coordinates don't already exist under a different ID anywhere in the database.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "LYluzIZLNXL5EKzv4vrDr",
      "type": "text",
      "x": -6448.066605791053,
      "y": -12272.991296345825,
      "width": 1115.2572021484375,
      "height": 40.184485975324776,
      "angle": 0,
      "strokeColor": "#2f9e44",
